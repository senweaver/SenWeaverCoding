{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SenWeaverCoding",
  "version": "0.1.0",
  "identifier": "com.senweaver.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "SenWeaverCoding",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "acceptFirstMouse": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=document-user-activation-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "minimal",
        "url": "index.html#minimal",
        "title": "senweaver",
        "width": 200,
        "height": 96,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=document-user-activation-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "minimal-input",
        "url": "index.html#minimal-input",
        "title": "senweaver",
        "width": 404,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=document-user-activation-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost https://www.google.com https://icons.duckduckgo.com https://*.gstatic.com; font-src 'self' data:; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:* ws://localhost:* http://localhost:*; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "publisher": "senweaver",
    "homepage": "https://github.com/senweaver/SenWeaverCoding",
    "category": "DeveloperTool",
    "shortDescription": "AI Code Editor & Autonomous Agent Runtime",
    "longDescription": "SenWeaverCoding is a Rust-first autonomous AI agent runtime and desktop code editor. Front-end built with React + Tauri, back-end embedded as a Rust library, providing interactive REPL, 130+ tools, memory/RAG, multi-provider LLM support and background agent sessions in a single installable application.",
    "copyright": "Copyright (C) 2025-2026 senweaver",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US", "zh-CN"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": ["English", "SimpChinese"],
        "compression": "lzma",
        "installerHooks": "windows/installer.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQUJEMjlFNjlBNDhFREMKUldUY2pxUnBudEtyV3ZIemRTbWNWSnpTTUdPelNtSUMycXRWb25rdlZQSnJlcncyY1Mzd3BZTVMK",
      "endpoints": [
        "https://github.com/senweaver/SenWeaverCoding/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
